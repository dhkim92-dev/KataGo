#version 450
// @author dhkim92.dev@gmail.com
// Add Channel Bias NC - GLSL compute shader (identity activation)
// Converted from HLSL add_channel_bias_nc_identity_fp32.hlsl

#include "common.h"
#include "functions.h"

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform AddChannelBiasNCParams {
    uint nSize;
    uint cSize;
} params;

layout(std430, binding = 0) buffer Accum {
    float data[];
} g_accum;

layout(std430, binding = 1) readonly buffer Bias {
    float bias[];
} g_bias;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint totalSize = params.nSize * params.cSize;
    if (idx >= totalSize) return;
    uint c = idx % params.cSize;
    float v = g_accum.data[idx] + g_bias.bias[c];
    g_accum.data[idx] = MISH(v);
}

