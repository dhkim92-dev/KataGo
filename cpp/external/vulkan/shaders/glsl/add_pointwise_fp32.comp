#version 450

/**
* @author dhkim92.dev@gmail.com
* @brief Add Point Wise FP32 compute shader
* Accumulates value into accum: accum[i] += value[i]
*/

#define PRECISION 32
#define PRECISION_STORAGE 32

#include "common.h"
#include "functions.h"

layout(constant_id=3) const int ELTS_PER_THREAD = 1;

layout(push_constant) uniform AddPointWiseParams {
    uint size;
};

layout(set = 0, binding = 0) buffer g_accum_block {
    realstore g_accum[];
};

layout(set = 0, binding = 1) readonly buffer g_value_block {
    realstore g_value[];
};

layout(local_size_x_id = 0, local_size_y_id = 1, local_size_z_id = 2) in;
void main() {
    const int offsetInTile = int(gl_LocalInvocationID.x);
    const int tileStart = int(gl_WorkGroupID.x) * ( int(gl_WorkGroupSize.x) * ELTS_PER_THREAD );

    for ( int d = 0 ; d < ELTS_PER_THREAD ; d++ ) {
        int s = tileStart + d * int(gl_WorkGroupSize.x) + offsetInTile;   
        if ( s < size ) {
            real result = LOAD(g_accum, s) + LOAD(g_value, s);
            STORE(g_accum, s, result);
        }
    }
}
