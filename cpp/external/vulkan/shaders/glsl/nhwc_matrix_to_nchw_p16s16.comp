#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer InputBuffer {
  float16_t inputData[];
};
layout(set = 0, binding = 1) writeonly buffer OutputBuffer {
  float16_t outputData[];
};

layout(push_constant) uniform NHWCMatrixToNCHWParams {
  int batchSize;
  int channels;
  int logicalSpatialSize;
  int spatialSize;
  int outputSpatialStride;
  int matrixChannels;
};

void main() {
  const int index = int(gl_GlobalInvocationID.x);
  const int total = batchSize * logicalSpatialSize * channels;
  if(index >= total)
    return;

  const int channel = index % channels;
  const int spatial = (index / channels) % logicalSpatialSize;
  const int batch = index / (channels * logicalSpatialSize);
  outputData[batch * channels * outputSpatialStride + channel * outputSpatialStride + spatial] =
    inputData[(batch * spatialSize + spatial) * matrixChannels + channel];
}
