#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require

// The cooperative-matrix ConvLayer path keeps the external tensor in NCHW
// format but uses a channel-last staging tensor. One invocation produces one
// aligned four-channel vector, so writes to the staging tensor are coalesced.
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer InputBuffer {
  float16_t inputData[];
};

layout(set = 0, binding = 1) writeonly buffer OutputBuffer {
  f16vec4 outputData[];
};

layout(push_constant) uniform NCHWToNHWCParams {
  int batchSize;
  int channels;
  int spatialSize;
  int spatialStride;
  int channelsPadded;
  int logicalSpatialSize;
};

void main() {
  const int vectorIndex = int(gl_GlobalInvocationID.x);
  const int vectorsPerSpatial = channelsPadded / 4;
  const int totalVectors = batchSize * spatialSize * vectorsPerSpatial;
  if(vectorIndex >= totalVectors)
    return;

  const int spatialIndex = vectorIndex / vectorsPerSpatial;
  const int channelVector = vectorIndex - spatialIndex * vectorsPerSpatial;
  const int channelBase = channelVector * 4;
  const int batch = spatialIndex / spatialSize;
  const int xy = spatialIndex - batch * spatialSize;
  const int inputBatchBase = batch * channels * spatialStride;

  f16vec4 value = f16vec4(0.0hf);
  for(int lane = 0; lane < 4; ++lane) {
    const int channel = channelBase + lane;
    if(channel < channels && xy < logicalSpatialSize)
      value[lane] = inputData[inputBatchBase + channel * spatialStride + xy];
  }
  outputData[vectorIndex] = value;
}
