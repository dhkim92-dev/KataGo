#version 450

/**
 * @file strided_batched_matmul_fp32.comp
 * @author dhkim92.dev@gmail.com
 * @brief Strided Batched Matrix Multiplication for 1x1 Convolution
 * 
 * Computes: C[batch] = A[batch] * B (same B for all batches)
 * 
 * Matrix layouts (KM_KN_NM convention from OpenCL):
 *   A (Input):  [K, M] per batch - strided by inputStride
 *   B (Filter): [K, N] - shared across all batches (filterStride = 0)
 *   C (Output): [N, M] per batch - strided by outputStride
 * 
 * For 1x1 Conv:
 *   M = nnXLen * nnYLen (spatial)
 *   K = inChannels
 *   N = outChannels
 *   numBatchElts = batchSize
 * 
 * Computes C = transpose(A) * B, effectively:
 *   C[n, m] = sum_k( A[k, m] * B[k, n] )
 */

#include "common.h"

// Padding to avoid bank conflicts (32 banks, 4 bytes each)
// Adding 1 column padding to shared memory
#define SBM_TILE_K_PADDED (SBM_TILE_K + 1)

/**
 * @brief Push constants for strided batched matmul
 */
layout(push_constant) uniform StridedBatchedMatmulParams {
    uint M;            // Columns of A, rows of C (spatial dim for 1x1 conv)
    uint N;            // Columns of B and C (outChannels)
    uint K;            // Rows of A and B (inChannels)
    // uint numBatchElts;   // Number of independent GEMMs (batchSize)
    uint inputStride;  // Elements between A matrices (M * K typically)
    uint filterStride; // Elements between B matrices (0 for shared filter)
    uint outputStride; // Elements between C matrices (M * N typically)
} params;

// Descriptor bindings (all in set 0)
// A (Input): [K, M] row-major per batch
layout(set = 0, binding = 0) readonly buffer gInput_block {
    float gInput[];
};

// B (Filter): [K, N] row-major, shared across batches
layout(set = 0, binding = 1) readonly buffer gFilter_block {
    float gFilter[];
};

// C (Output): [N, M] row-major per batch
layout(set = 0, binding = 2) buffer gOutput_block {
    float gOutput[];
};

// Shared memory with padding to avoid bank conflicts
shared float Asub[SBM_TILE_K][SBM_TILE_M + 1];  // [K][M] tile, +1 for bank conflict avoidance
shared float Bsub[SBM_TILE_K][SBM_TILE_N + 1];  // [K][N] tile, +1 for bank conflict avoidance

layout(local_size_x = SBM_TILE_M, local_size_y = SBM_TILE_N, local_size_z = 1) in;

void main()
{
    uvec3 DTid = gl_GlobalInvocationID;
    uvec3 GTid = gl_LocalInvocationID;
    uvec3 GId  = gl_WorkGroupID;

    // Group and thread indices
    uint groupM = GId.x;  // Tile index along M axis
    uint groupN = GId.y;  // Tile index along N axis
    uint batch  = GId.z;  // Batch index
    
    uint localM = GTid.x; // 0..SBM_TILE_M-1
    uint localN = GTid.y; // 0..SBM_TILE_N-1

    // Global indices for this thread's output element
    uint globalM = groupM * SBM_TILE_M + localM;
    uint globalN = groupN * SBM_TILE_N + localN;

    // Base offsets for this batch
    uint aBase = batch * params.inputStride;
    uint bBase = batch * params.filterStride;  // 0 if filter is shared
    uint cBase = batch * params.outputStride;

    // Accumulator for dot product
    float acc = 0.0;

    // Linear thread ID for cooperative loading
    uint tid = localM * SBM_TILE_N + localN;  // 0..255
    uint numThreads = SBM_TILE_M * SBM_TILE_N; // 256

    // Number of elements to load per tile
    uint aEltsPerTile = SBM_TILE_K * SBM_TILE_M;  // 256
    uint bEltsPerTile = SBM_TILE_K * SBM_TILE_N;  // 256

    // Loop over K dimension in blocks
    uint numKBlocks = (params.K + SBM_TILE_K - 1) / SBM_TILE_K;
    
    for (uint kb = 0; kb < numKBlocks; ++kb) {
        uint kBase = kb * SBM_TILE_K;

        // Cooperative loading of A tile [K][M] into shared memory
        // A is stored as [K, M] row-major: A[k, m] = gInput[aBase + k * M + m]
        for (uint i = tid; i < aEltsPerTile; i += numThreads) {
            uint tileK = i / SBM_TILE_M;
            uint tileM = i % SBM_TILE_M;
            uint globalK = kBase + tileK;
            uint gM = groupM * SBM_TILE_M + tileM;
            
            float val = 0.0;
            if (globalK < params.K && gM < params.M) {
                uint aIdx = aBase + globalK * params.M + gM;
                val = gInput[aIdx];
            }
            Asub[tileK][tileM] = val;
        }

        // Cooperative loading of B tile [K][N] into shared memory
        // B is stored as [K, N] row-major: B[k, n] = gFilter[bBase + k * N + n]
        for (uint j = tid; j < bEltsPerTile; j += numThreads) {
            uint tileK = j / SBM_TILE_N;
            uint tileN = j % SBM_TILE_N;
            uint globalK = kBase + tileK;
            uint gN = groupN * SBM_TILE_N + tileN;
            
            float val = 0.0;
            if (globalK < params.K && gN < params.N) {
                uint bIdx = bBase + globalK * params.N + gN;
                val = gFilter[bIdx];
            }
            Bsub[tileK][tileN] = val;
        }

        memoryBarrierShared();
        barrier();

        // Compute partial dot product for this K-block
        // C[n, m] = sum_k( A[k, m] * B[k, n] )
        for (uint kk = 0; kk < SBM_TILE_K; ++kk) {
            float aVal = Asub[kk][localM];
            float bVal = Bsub[kk][localN];
            acc += aVal * bVal;
        }

        memoryBarrierShared();
        barrier();
    }

    // Write result to output
    // C is stored as [N, M] row-major: C[n, m] = gOutput[cBase + n * M + m]
    if (globalM < params.M && globalN < params.N) {
        uint cIdx = cBase + globalN * params.M + globalM;
        gOutput[cIdx] = acc;
    }
}
